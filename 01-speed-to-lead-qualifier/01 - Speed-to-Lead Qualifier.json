    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// 1) Get the lead data and the AI's answer\nconst lead = $('Clean Website Text').item.json;\nconst ai = $json.output || {};\n\n// helper: keep a number between min and max\nconst clamp = (n, min, max) => Math.max(min, Math.min(max, Number(n) || 0));\n\n// 2) Budget points (max 40) — fixed rules\nconst b = (lead.budget || '').replace(/\\s/g, '');\nconst budgetPts = /10,?000\\+/.test(b) ? 40      // $10,000+\n  : /^\\$?2,?000/.test(b) ? 30                    // $2,000–$10,000\n  : /^\\$?500/.test(b) ? 15                       // $500–$2,000\n  : 5;                                           // Under $500\n\n// 3) Timeline points (max 25) — fixed rules\nconst t = (lead.timeline || '').toLowerCase();\nconst timelinePts = t.includes('asap') ? 25\n  : /1\\s*[-–]\\s*3/.test(t) ? 15                  // 1–3 months\n  : 5;                                           // Just exploring\n\n// 4) AI points (fit max 25, legitimacy max 10)\nconst fit = clamp(ai.fit_score, 0, 25);\nconst legit = clamp(ai.legitimacy_score, 0, 10);\n\n// 5) Total score and tier\nconst score = budgetPts + timelinePts + fit + legit;\nconst tier = score >= 70 ? 'hot' : score >= 40 ? 'warm' : 'cold';\n\n// 6) Output one clean item\nreturn { json: {\n  ...lead,\n  score,\n  tier,\n  score_breakdown: { budget: budgetPts, timeline: timelinePts, fit, legitimacy: legit },\n  company_summary: ai.company_summary || 'Not available',\n  use_case: ai.use_case || '',\n  red_flags: ai.red_flags || [],\n  next_action: ai.next_action || '',\n  ai_reason: ai.reason || '',\n}};"
      },
