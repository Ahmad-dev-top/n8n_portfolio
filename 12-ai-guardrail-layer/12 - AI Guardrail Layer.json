    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const text = $json.text || '';\n\nconst piiPatterns = {\n  iban: /\\bPK\\d{2}[A-Z]{4}\\d{16}\\b/gi,\n  cnic: /\\b\\d{5}-?\\d{7}-?\\d\\b/g,\n  phone_pk: /(\\+92|0092|0)[-\\s]?3\\d{2}[-\\s]?\\d{7}\\b/g,\n  email: /[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}/g,\n  card: /\\b(?:\\d[ -]?){13,16}\\b/g,\n};\n\nlet redacted = text;\nconst piiFound = [];\nfor (const [type, re] of Object.entries(piiPatterns)) {\n  const m = redacted.match(re);\n  if (m) {\n    piiFound.push({ type, count: m.length });\n    redacted = redacted.replace(re, `[${type.toUpperCase()}]`);\n  }\n}\n\nconst injectionRules = [\n  { label: 'Override previous instructions', re: /ignore (all |the )?(previous|prior|above) instructions/i },\n  { label: 'Disregard rules',                re: /disregard .*(instructions|rules)/i },\n  { label: 'Role hijack',                    re: /you are now/i },\n  { label: 'Secret/prompt extraction',       re: /(reveal|show|print) .*(system prompt|instructions|api key|password)/i },\n  { label: 'Jailbreak keyword',              re: /developer mode|jailbreak|\\bDAN\\b/i },\n  { label: 'Privilege escalation',           re: /act as .*(admin|system|unrestricted)/i },\n];\nconst ruleHits = injectionRules.filter(r => r.re.test(text)).map(r => r.label);\n\nreturn {\n  json: {\n    redacted_text: redacted,\n    pii_found: piiFound,\n    rule_hits: ruleHits,\n    rule_risk: ruleHits.length > 0 ? 'high' : 'low',\n    direction: $json.direction || 'input',\n    source: $json.source || 'manual-test',\n    provider: ($json.provider || 'groq').toLowerCase(),\n    started_at: Date.now(),\n  },\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
