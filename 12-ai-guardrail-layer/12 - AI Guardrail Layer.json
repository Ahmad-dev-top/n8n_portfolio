      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const base = $('PII Redact + Rules').item.json;\nconst ai = $json.output || {};\nconst risk = Number(ai.risk_score ?? 100);\nconst safe = ai.safe === true && risk < 60;\n\nreturn { json: {\n  decision: safe ? 'allow' : 'block',\n  safe_text: base.redacted_text,\n  category: ai.category || 'unknown',\n  risk_score: risk,\n  reason: ai.reason || '',\n  pii_found: base.pii_found,\n  checked_by: 'rules+ai',\n  provider: base.provider,\n  source: base.source,\n  direction: base.direction,\n  started_at: base.started_at,\n}};"
      },
